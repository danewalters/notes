---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link rel="self" type="application/atom+xml" href="{{ site.url }}/feed.xml"/>
  <link rel="alternate" type="text/html" href="{{ site.url }}/"/>
  {%- if collections.posts.length %}
  <updated>{{ collections.posts | latestUpdate | isoDate }}</updated>
  {%- endif %}
  <id>{{ site.url }}/feed.xml</id>
  <author><name>{{ site.name }}</name></author>
  {%- for post in collections.posts %}
  <entry>
    <title>{{ post.data.title }}</title>
    <published>{{ post.date | isoDate }}</published>
    <updated>{{ (post.data.updated or post.date) | isoDate }}</updated>
    <link rel="alternate" type="text/html" href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    {%- if post.data.description %}
    <summary>{{ post.data.description }}</summary>
    {%- endif %}
    <content type="html" xml:base="{{ site.url }}{{ post.url }}">{{ post.content | absoluteUrls(site.url) }}</content>
  </entry>
  {%- endfor %}
</feed>
