---
layout: base.njk
bodyClass: homepage
---
<div id="wrapper">
  <main>
    <section id="info">
      {% if site.avatar %}
      <img src="{{ site.avatar }}" alt="avatar">
      {% endif %}
      <div id="text">
        <div>
          <span id="name">{{ site.name }}</span>
          {% if site.handle %}
          <span id="id">@{{ site.handle }}</span>
          {% endif %}
        </div>
        {% if site.bio %}
        <div id="bio">{{ site.bio }}</div>
        {% endif %}
      </div>
    </section>
    <section id="links">
      <div id="left">
        {% for item in site.nav %}
        {% if item.path.startsWith("/") and not item.path.startsWith("//") %}
        <a href="{{ item.path }}">{{ item.name }}</a>
        {% else %}
        <a href="{{ item.path }}" class="external" target="_blank" rel="noreferrer noopener">{{ item.name }}</a>
        {% endif %}
        {% endfor %}
      </div>
      <div id="right">
        {% for link in site.links %}
        <a href="{{ link.url }}" aria-label="{{ link.name }}" target="_blank" rel="noreferrer noopener">{{ link.icon | icon | safe }}</a>
        {% endfor %}
        {% include "theme-toggle.njk" %}
      </div>
    </section>
    <section id="brief" class="prose">
      {{ content | safe }}
    </section>
    {% if recent %}
    <section class="layout-list">
      {% set posts = collections.posts.slice(0, recent) %}
      {% include "post-list.njk" %}
      <div class="read-more">
        <a href="/posts/">{{ recentMoreText }}</a>
      </div>
    </section>
    {% endif %}
  </main>
</div>
